{
  "name": "guttercaps-workspace",
  "private": true,
  "scripts": {
    "test": "vitest run --config tests/localnet/vitest.config.mts",
    "test:validator": "node --experimental-strip-types tests/localnet/run-validator.ts",
    "lock:matrix": "node --experimental-strip-types scripts/npm-lock-matrix.ts --selftest && node --experimental-strip-types scripts/npm-lock-matrix.ts",
    "lock:integrity": "node --experimental-strip-types scripts/lock-integrity.ts",
    "localnet:build": "sh scripts/anchor-build-localnet.sh",
    "localnet:fixtures": "node --experimental-strip-types tests/localnet/fetch-fixtures.ts",
    "verify": "npm run legal:test && npm run lock:matrix && npm run lock:integrity -- --selftest && npm run lock:integrity && npm run economy:check && npm run economy:test && npm run security:static && npm --prefix client run typecheck && npm --prefix client test && npm --prefix client run build && npm run bundle:check && npm --prefix backend run typecheck && npm run backend:test && npm run landing:check && npm run api:check && npm run program-ids -- status && npm run env:check && npm run schema:check && npm run ops:buildenv -- --selftest && npm run ops:restore-drill -- --selftest && npm run verify-deploy -- --selftest && npm run audit:gate -- --selftest && npm run workflows:check && npm run selftest:cargolock && npm run selftest:junit && npm run selftest:cu && npm run selftest:macdevnet && npm run state:layout && npm run state:layout -- --selftest && npm run fonts:check && npm run docs:refs",
    "setup": "node --experimental-strip-types scripts/setup.ts",
    "skr-pool": "node --experimental-strip-types scripts/skr-pool.ts",
    "pyth-pusher": "node --experimental-strip-types scripts/pyth-pusher.ts",
    "create-lut": "node --experimental-strip-types scripts/create-lut.ts",
    "backend:pyth-cache": "npm --prefix backend run pyth-cache",
    "backend:crank": "npm --prefix backend run crank",
    "backend:burn-oracle": "npm --prefix backend run burn-oracle",
    "backend:reward-oracle": "npm --prefix backend run reward-oracle",
    "backend:battle-resolver": "npm --prefix backend run battle-resolver",
    "backend:antifraud": "npm --prefix backend run antifraud --",
    "economy:report": "npm --prefix packages/economy run report",
    "economy:test": "npm --prefix packages/economy test",
    "security:static": "node --experimental-strip-types --no-warnings --test tests/security/*.test.ts",
    "economy:golden": "npm --prefix packages/economy run golden",
    "backend:dev": "npm --prefix backend run dev",
    "backend:backfill": "npm --prefix backend run backfill",
    "backend:rebuild": "npm --prefix backend run rebuild",
    "backend:test": "npm --prefix backend test",
    "landing:build": "python3 scripts/landing/build.py",
    "landing:check": "python3 -m unittest discover -s scripts/landing -p '*_test.py' && node --experimental-strip-types scripts/landing/check.ts && node scripts/landing/smoke.mjs",
    "assets:inventory": "python3 scripts/asset-inventory.py",
    "assets:qa": "python3 scripts/asset-visual-qa.py",
    "assets:pipeline": "node --experimental-strip-types scripts/art-pipeline.ts",
    "assets:portfolio": "python3 scripts/export-portfolio.py",
    "economy:check": "npm --prefix packages/economy run check && npm --prefix packages/economy run golden && node --experimental-strip-types packages/economy/scripts/sync-check.ts",
    "programs:test": "cargo test --workspace",
    "programs:build": "anchor build",
    "programs:fmt": "cargo fmt --all",
    "programs:gate": "cargo fmt --all -- --check && cargo clippy --locked --workspace --all-targets -- -D warnings -A deprecated -A unexpected_cfgs && cargo test --locked --workspace && cargo test --locked --release --workspace",
    "api:check": "node --experimental-strip-types scripts/api-contract.ts",
    "bundle:check": "node --experimental-strip-types scripts/bundle-check.ts",
    "e2e:build": "VITE_API_MOCK=1 npm --prefix client run build",
    "e2e:install": "if [ \"$(uname)\" = Darwin ]; then playwright install chromium; else playwright install --with-deps chromium; fi",
    "e2e:types": "tsc -p tests/e2e --noEmit",
    "e2e": "playwright test",
    "e2e:mock": "npm run e2e:build && npm run e2e:types && playwright test --project=desktop-chromium",
    "lhci": "npm run e2e:build && lhci autorun",
    "load:login": "node scripts/load/login.mjs",
    "load:lt1": "k6 run scripts/load/lt1.js",
    "load:lt3": "node --no-warnings=ExperimentalWarning --import tsx scripts/load/lt3.ts",
    "load:soak-g3": "node --no-warnings=ExperimentalWarning --import tsx scripts/load/soak-g3.ts",
    "load:soak-g3:test": "vitest run scripts/load/soak-g3.test.ts",
    "openapi:gen": "cd client && npx openapi-typescript ../backend/openapi.yaml -o src/api/schema.d.ts",
    "ops:up": "docker compose -f ops/deploy/docker-compose.yaml up -d",
    "ops:build": "docker compose -f ops/deploy/docker-compose.yaml build",
    "ops:buildenv": "node --no-warnings=ExperimentalWarning --import tsx scripts/deploy-build-env.ts",
    "workflows:check": "node --no-warnings=ExperimentalWarning --import tsx scripts/check-workflows.ts",
    "docs:refs": "node --no-warnings=ExperimentalWarning --import tsx scripts/check-docrefs.ts",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "ops:logs": "docker compose -f ops/deploy/docker-compose.yaml logs -f --tail=200",
    "program-ids": "node --experimental-strip-types scripts/program-ids.ts",
    "verify-deploy": "node --experimental-strip-types scripts/verify-deploy.ts",
    "audit:gate": "node --experimental-strip-types scripts/audit-gate.ts",
    "keypairs:scan": "node --experimental-strip-types scripts/committed-keypairs.ts",
    "secret:scan": "node --experimental-strip-types scripts/secret-scan.ts",
    "ix:shape": "node --experimental-strip-types scripts/ix-shape.ts",
    "env:example": "node --experimental-strip-types scripts/env-doc.ts --write",
    "env:check": "node --experimental-strip-types scripts/env-doc.ts --check",
    "backend:start": "npm --prefix backend run start",
    "ops:down": "docker compose -f ops/deploy/docker-compose.yaml down",
    "ops:ps": "docker compose -f ops/deploy/docker-compose.yaml ps",
    "ops:config": "docker compose -f ops/deploy/docker-compose.yaml config -q && echo \"compose config ok\"",
    "ops:backup-now": "docker compose -f ops/deploy/docker-compose.yaml exec -e RUN_ONCE=1 backup sh /backup/sqlite-backup.sh --once",
    "ops:restore-drill": "node --no-warnings=ExperimentalWarning scripts/restore-drill.mjs",
    "ops:prometheus": "docker compose -f ops/deploy/docker-compose.yaml --profile monitoring up -d prometheus alertmanager alert-webhook",
    "schema:check": "node --experimental-strip-types scripts/schema-drift.ts --check",
    "state:layout": "node --experimental-strip-types --no-warnings scripts/state-layout.ts",
    "fonts:vendor": "node --experimental-strip-types --no-warnings scripts/vendor-fonts.ts --write",
    "fonts:check": "node --experimental-strip-types --no-warnings scripts/vendor-fonts.ts --check && node --experimental-strip-types --no-warnings scripts/vendor-fonts.ts --selftest",
    "schema:drift": "node --experimental-strip-types scripts/schema-drift.ts --write",
    "selftest:cargolock": "sh scripts/selftest-cargo-lock.sh",
    "selftest:junit": "sh scripts/selftest-surface-junit.sh",
    "selftest:cu": "sh scripts/selftest-surface-cu.sh",
    "selftest:macdevnet": "bash scripts/selftest-mac-devnet.sh",
    "e2e:errors": "VITE_API_MOCK=0 npm --prefix client run build -- --outDir ../.arena/error-client && E2E_REAL_ERRORS=1 playwright test --config playwright.errors.config.ts --project=desktop-chromium --workers=1",
    "legal:check": "node scripts/legal-readiness.mjs",
    "legal:test": "node --test tests/legal/*.test.mjs",
    "ops:release": "docker compose -f ops/deploy/docker-compose.yaml pull && docker compose -f ops/deploy/docker-compose.yaml up -d",
    "privacy:retention": "node --no-warnings=ExperimentalWarning --import tsx backend/src/privacy-maintenance.ts retention",
    "privacy:reapply": "node --no-warnings=ExperimentalWarning --import tsx backend/src/privacy-maintenance.ts reapply-erasure",
    "mac:devnet": "bash scripts/mac-devnet.sh"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.8",
    "@solana/web3.js": "^1.99.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^24.19.1",
    "litesvm": "^1.4.1",
    "sharp": "^0.35.4",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  },
  "workspaces": [
    "packages/*",
    "client",
    "backend"
  ],
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jayson": "^5.0.0",
    "toml": "^5.0.0"
  }
}
