# Overlay on top of backend/.env.example for the devnet VPS (guttercapsdev).
# Do not copy backend/.env from the mainnet box.

# --- production fail-fast (NODE_ENV=production on this box too) ---
COOKIE_SECURE=1
CORS_ORIGINS=https://dev.guttercaps.gg
SIWS_DOMAINS=dev.guttercaps.gg
PRODUCTION_DB_MODE=sqlite-single-instance
BUBBLEGUM_V2_ENABLED=1
RATE_LIMIT=1
TRUST_PROXY_HOPS=1

# --- secrets: different from guttercaps ---
SESSION_SECRET=
DEVICE_SALT=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=dev.guttercaps.gg
TURNSTILE_ACTION=claim

# --- cluster ---
SOLANA_RPC_URL=
SOLANA_WS_URL=
PROGRAM_CHIP_CORE=
PROGRAM_MARKET=
PROGRAM_STAKING=
PROGRAM_ARENA=
LOOKUP_TABLE=
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SKR_MINT=
ADMIN_WALLETS=

# Devnet API must not collect mainnet presale SOL. Leave treasury empty unless this
# origin is deliberately the same preorder flow (then it is the real mainnet treasury,
# never a made-up key).
PREORDER_TREASURY=
PREORDER_ACTIVE=

CRANK_KEYPAIR=
BATTLE_ORACLE_KEYPAIR=
BURN_ORACLE_KEYPAIR=
QUEST_ORACLE_KEYPAIR=
SEASON_ORACLE_KEYPAIR=
