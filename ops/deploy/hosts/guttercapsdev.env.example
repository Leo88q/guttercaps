# Compose overlay for the devnet VPS. Copy to ops/deploy/.env (git-ignored).
# Different box than guttercaps — do not reuse mainnet PROGRAM_*, crank, or SESSION_SECRET.
#
# Host name: guttercapsdev. Cluster: devnet. Origin example: https://dev.guttercaps.gg

# --- cluster / program identity (shared by both images) ---
PROGRAM_CHIP_CORE=
PROGRAM_MARKET=
PROGRAM_STAKING=
PROGRAM_ARENA=
CG_MINT=
# Circle USDC on Solana devnet. Not a secret. Not the mainnet mint.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
SKR_MINT=
LOOKUP_TABLE=
TURNSTILE_SITE_KEY=

# --- client build (baked; changing these needs ops:build, not a restart) ---
VITE_CLUSTER=devnet
VITE_SOLANA_RPC=
VITE_SENTRY_DSN=

# --- image refs (empty = build locally as guttercaps/<name>:local) ---
API_IMAGE=
CLIENT_IMAGE=
BACKUP_IMAGE=

# --- host plumbing ---
# Loopback only — same reason as guttercaps.env.example.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
WORKERS=crank,pyth
# Host file only. Process path is /run/secrets/crank_keypair (see docker-compose.yaml).
CRANK_KEYPAIR_PATH=./secrets/crank_keypair.json
BACKFILL_START_PERIOD=30m

# --- legal gating ---
GEO_GATE=off
GEO_TRUST_HEADER=0
GEO_RESTRICT_COUNTRIES=BE,NL
GEO_UNKNOWN=allow
COMPLIANCE_ENFORCE=1

# --- redis ---
REDIS_MAXMEMORY=128mb

# --- backups ---
BACKUP_INTERVAL_S=3600
BACKUP_KEEP=72
BACKUP_KEEP_CORRUPT=3
BACKUP_S3_URI=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# --- monitoring (profile: monitoring) ---
PROM_BIND=127.0.0.1
PROM_RETENTION=30d
ALERTMANAGER_BIND=127.0.0.1
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
