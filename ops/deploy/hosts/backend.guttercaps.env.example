# Overlay on top of backend/.env.example for the mainnet VPS (guttercaps).
# Copy backend/.env.example → backend/.env, then set the values below.
# Compose already sets NODE_ENV/HOST/PORT/DB_PATH/REDIS_URL/EVENT_BUS/CRANK_KEYPAIR
# (file secret). Do not put the crank JSON in this file.
#
# Origin example: https://app.guttercaps.gg — must match the Cloudflare hostname.

# --- production fail-fast (assertProductionConfig) ---
COOKIE_SECURE=1
CORS_ORIGINS=https://app.guttercaps.gg
SIWS_DOMAINS=app.guttercaps.gg
PRODUCTION_DB_MODE=sqlite-single-instance
BUBBLEGUM_V2_ENABLED=1
RATE_LIMIT=1
TRUST_PROXY_HOPS=1
# Do not set FINALITY_ASSUME=1.

# --- secrets: generate on the box, never commit ---
SESSION_SECRET=
DEVICE_SALT=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=app.guttercaps.gg,.guttercaps.gg
TURNSTILE_ACTION=claim

# --- cluster (must match ops/deploy/.env / the client build) ---
SOLANA_RPC_URL=
SOLANA_WS_URL=
PROGRAM_CHIP_CORE=
PROGRAM_MARKET=
PROGRAM_STAKING=
PROGRAM_ARENA=
LOOKUP_TABLE=
# Same USDC as the compose overlay. SKR/CG from setup.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SKR_MINT=
ADMIN_WALLETS=

# --- founder presale ---
# Paste the treasury pubkey you already use for mainnet SOL. Do not invent one.
# USDC/SKR, if enabled, go to ATAs of this same wallet — not a second address.
PREORDER_TREASURY=
PREORDER_ACTIVE=

# Compose `environment:` sets CRANK_KEYPAIR=/run/secrets/crank_keypair (overrides this).
# Leave empty so a stray backend/.env cannot point at a host path inside the image.
CRANK_KEYPAIR=
BATTLE_ORACLE_KEYPAIR=
BURN_ORACLE_KEYPAIR=
QUEST_ORACLE_KEYPAIR=
SEASON_ORACLE_KEYPAIR=
