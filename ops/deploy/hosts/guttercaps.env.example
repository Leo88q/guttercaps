# Compose overlay for the mainnet VPS. Copy to ops/deploy/.env (git-ignored).
# This is NOT backend/.env — see backend.guttercaps.env.example for that file.
#
# Host name: guttercaps. Cluster: mainnet-beta. Origin example: https://app.guttercaps.gg
# Fill every empty PROGRAM_* / mint / VITE_RPC_URL from `npm run program-ids -- manifest`
# and your RPC provider. Do not paste a second cluster's ids here.

# --- cluster / program identity (shared by both images) ---
PROGRAM_CHIP_CORE=
PROGRAM_MARKET=
PROGRAM_STAKING=
PROGRAM_ARENA=
PROGRAM_SETTLE=
CG_MINT=
# Circle USDC on Solana mainnet. Not a secret. SKR/CG come from setup, not from chat.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SKR_MINT=
LOOKUP_TABLE=

# --- client build (baked; changing these needs ops:build, not a restart) ---
VITE_CLUSTER=mainnet-beta
VITE_RPC_URL=
VITE_RPC_WS_URL=
VITE_DAS_RPC_URL=
LAUNCH_PHASE=g      # Фаза Г (решение владельца 2026-11-06): своих программ ноль, минт и кулдауны — бэкенд.
                    # Второй файл (backend/.env) обязан говорить то же самое: клиент собирается этим же значением.
                    # Прежний эталон `full` (п. 60) стоил 20.54 SOL залога на mainnet; g — ≈0.27 SOL. Требуемая
                    # этим профилем фазовая пара ниже (SHARED_MERKLE_TREE, CORE_COLLECTION_*…) без значений — отказ
                    # старта backend'а, поэтому заполнять их нужно ДО первого старта, из вывода setup-minimal.

# Казна: адрес, куда приходят оплаты паков (фаза Г продаёт через бэкенд, поэтому казна задаётся здесь, а не
# только в программе). В `g` пустое значение — отказ старта: деньги ушли бы «в никуда».
TREASURY_WALLET=

# --- phase G: ончейн-минимум (печатает `npm run setup:minimal -- --execute`, блок env) ---
# Одно общее дерево Bubblegum вместо «дерева на район»: минт делает бэкенд, поэтому второго дерева не нужно.
SHARED_MERKLE_TREE=
# Восемь MPL Core коллекций районов. Пустая допустима (фишка вымintится без коллекции, маркетплейс покажет
# её без группы), кривая — отказ старта: `assertProductionConfig` проверяет каждый непустой адрес.
CORE_COLLECTION_0=
CORE_COLLECTION_1=
CORE_COLLECTION_2=
CORE_COLLECTION_3=
CORE_COLLECTION_4=
CORE_COLLECTION_5=
CORE_COLLECTION_6=
CORE_COLLECTION_7=
# Коллекция недели (0..7) — её показывает магазин; неверное число тоже отказ старта.
PHASEG_FEATURED_COLLECTION=0

# --- профиль В (тонкая программа `settle`): что меняется, если LAUNCH_PHASE=v ---
# Эталон запуска — фаза Г (выше), но профиль В живой и остаётся опцией владельца; его цена и порядок
# включения — docs/PHASED-ONCHAIN-PLAN.md, раздел «Фаза В». Смена фазы — это заполнение тех же строк
# плюс ОДИН новый ключ, а не новый файл:
#   TREASURY_WALLET            — тот же адрес (эскроу расчётов возвращает оплату сюда);
#   SHARED_MERKLE_TREE, CG_MINT, PHASEG_FEATURED_COLLECTION — те же значения, что в фазе Г;
#   CRANK_KEYPAIR              — тот же (в фазе В кранк ведёт тик подтверждения settle-confirm). В compose он
#                               подаётся секретом `crank_keypair`, поэтому здесь только путь:
#                               CRANK_KEYPAIR_PATH=./secrets/crank_keypair.json;
#   PHASEV_ORACLE_KEYPAIR      — НОВЫЙ: MINT_ORACLE, который подписывает settle_pack/grant_mint. Ключ минта
#                               фазы Г (MINT_AUTHORITY_KEYPAIR) в профиле В не нужен и не читается.
# Отсутствие любого из них в фазе В — отказ старта backend'а, а не 410 (backend/src/config.ts).
# Проверка профиля без секретов: npm run launch:check -- --selftest (все три фазы сверяются со своими ключами).

# --- image refs (empty = build locally as guttercaps/<name>:local) ---
API_IMAGE=
CLIENT_IMAGE=
BACKUP_IMAGE=

# --- host plumbing ---
# Loopback only: Cloudflare Tunnel on the host talks to 127.0.0.1:8080. 0.0.0.0
# plus nginx real_ip (CF-Connecting-IP) is a spoofable rate-limit key.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
WORKERS=crank,pyth
# Host file for compose `secrets.crank_keypair.file`. The process reads
# /run/secrets/crank_keypair (hardcoded in docker-compose.yaml). Do not put this
# host path in backend/.env CRANK_KEYPAIR.
CRANK_KEYPAIR_PATH=./secrets/crank_keypair.json
BACKFILL_START_PERIOD=30m

# --- legal gating ---
GEO_GATE=off
GEO_TRUST_HEADER=0
GEO_RESTRICT_COUNTRIES=BE,NL
GEO_UNKNOWN=allow
# Обязательно и явно: 1 = access-policy.json исполняется, 0 = гейты выключены осознанно (старт печатает
# предупреждение [compliance]). Unset/иное — отказ старта (assertProductionConfig). See hetzner.md §5.
COMPLIANCE_ENFORCE=0

# --- redis ---
REDIS_MAXMEMORY=128mb

# --- backups ---
BACKUP_INTERVAL_S=3600
BACKUP_KEEP=72
BACKUP_KEEP_CORRUPT=3
BACKUP_S3_URI=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# --- monitoring (profile: monitoring) ---
PROM_BIND=127.0.0.1
PROM_RETENTION=30d
ALERTMANAGER_BIND=127.0.0.1
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
