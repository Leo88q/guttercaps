# Compose overlay for the mainnet VPS. Copy to ops/deploy/.env (git-ignored).
# This is NOT backend/.env — see backend.guttercaps.env.example for that file.
#
# Host name: guttercaps. Cluster: mainnet-beta. Origin example: https://app.guttercaps.gg
# Fill every empty PROGRAM_* / mint / VITE_SOLANA_RPC from `npm run program-ids -- manifest`
# and your RPC provider. Do not paste a second cluster's ids here.

# --- cluster / program identity (shared by both images) ---
PROGRAM_CHIP_CORE=
PROGRAM_MARKET=
PROGRAM_STAKING=
PROGRAM_ARENA=
CG_MINT=
# Circle USDC on Solana mainnet. Not a secret. SKR/CG come from setup, not from chat.
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
SKR_MINT=
LOOKUP_TABLE=
TURNSTILE_SITE_KEY=

# --- client build (baked; changing these needs ops:build, not a restart) ---
VITE_CLUSTER=mainnet-beta
VITE_SOLANA_RPC=
VITE_SENTRY_DSN=

# --- image refs (empty = build locally as guttercaps/<name>:local) ---
API_IMAGE=
CLIENT_IMAGE=
BACKUP_IMAGE=

# --- host plumbing ---
# Loopback only: Cloudflare Tunnel on the host talks to 127.0.0.1:8080. 0.0.0.0
# plus nginx real_ip (CF-Connecting-IP) is a spoofable rate-limit key.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
WORKERS=crank,pyth
# Host file for compose `secrets.crank_keypair.file`. The process reads
# /run/secrets/crank_keypair (hardcoded in docker-compose.yaml). Do not put this
# host path in backend/.env CRANK_KEYPAIR.
CRANK_KEYPAIR_PATH=./secrets/crank_keypair.json
BACKFILL_START_PERIOD=30m

# --- legal gating ---
GEO_GATE=off
GEO_TRUST_HEADER=0
GEO_RESTRICT_COUNTRIES=BE,NL
GEO_UNKNOWN=allow
# Production refuses to boot unless this is 1 (assertProductionConfig). See hetzner.md §5.
COMPLIANCE_ENFORCE=1

# --- redis ---
REDIS_MAXMEMORY=128mb

# --- backups ---
BACKUP_INTERVAL_S=3600
BACKUP_KEEP=72
BACKUP_KEEP_CORRUPT=3
BACKUP_S3_URI=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# --- monitoring (profile: monitoring) ---
PROM_BIND=127.0.0.1
PROM_RETENTION=30d
ALERTMANAGER_BIND=127.0.0.1
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
