# GUTTERCAPS compose deploy — the variables `ops/deploy/docker-compose.yaml` interpolates.
#
# This is NOT the app's config: the app reads backend/.env (see that file's example for the full list
# of 95 vars). What is here is only what compose itself needs, and the reason it is small is
# deliberate — every value the app reads from a container env is one more thing to forget at 3 a.m.
#
# Copy to .env next to this file, then:  npm run ops:build && npm run ops:up
# Validation without Docker: `npm run env:check` (this file vs the compose file, both directions).
#
# ── required, no default ───────────────────────────────────────────────────────────────────────
#   VITE_RPC_URL      a mainnet RPC the *browser* may use; keep the key rate-limited per origin.
#                     (Имя именно такое: client/src/app/config.ts читает VITE_RPC_URL.)
#   PROGRAM_*         the four program ids from `npm run program-ids -- manifest`. They are passed to
#                     BOTH images on purpose: the client bundle and the API must not be able to disagree,
#                     and a mismatch is a game where every transaction fails with 0x177a.
#   CG_MINT, USDC_MINT, SKR_MINT   mints, resolved by address (never by symbol).
# ── secrets live in files, not here ────────────────────────────────────────────────────────────
#   CRANK_KEYPAIR_PATH  host path to the crank hot keypair (default ./secrets/crank_keypair.json,
#                       git-ignored). Compose mounts it at /run/secrets/crank_keypair and sets
#                       CRANK_KEYPAIR to that in-container path — this variable is NOT the path
#                       the process reads. Putting the host path into CRANK_KEYPAIR is how a
#                       copy-paste deploy silently never opens packs.
#   <NAME>_KEYPAIR      what the *process* reads (CRANK_KEYPAIR, MINT_AUTHORITY_KEYPAIR and the oracle
#                       keys). Three forms only: a path (docker secret / mount), `file:<path>`, or
#                       `env:<VAR>` holding the key itself (JSON 64 bytes or base64 raw 32). `kms://`,
#                       `vault://`, `hsm://` are refused at boot — no KMS provider is wired yet, and a
#                       silent fallback would be a signer nobody checked (ops/deploy/runbook.md §1.4).

# --- cluster / program identity (shared by both images) ---
PROGRAM_CHIP_CORE=
PROGRAM_MARKET=
PROGRAM_STAKING=
PROGRAM_ARENA=
PROGRAM_SETTLE=
CG_MINT=
USDC_MINT=
SKR_MINT=
LOOKUP_TABLE=

# --- client build (baked into the bundle at build time; changing them needs `ops:build`, not a restart) ---
# Имена — ровно те, что читает client/src/app/config.ts (находки 5/6): VITE_RPC_URL, а не
# VITE_SOLANA_RPC (его приложение не читает), и VITE_LAUNCH_PHASE, без которого фазовый запуск
# собирался как full. VITE_API_BASE/VITE_WS_BASE заданы в compose (/v1 и /ws) — nginx проксирует
# именно их; «/» давал //me, то есть запросы на чужой хост.
VITE_CLUSTER=mainnet-beta
VITE_RPC_URL=
VITE_RPC_WS_URL=
VITE_DAS_RPC_URL=
LAUNCH_PHASE=full   # одна фаза для обоих образов: клиент собирается как g|v|full
VITE_FLAG_GEO_GATE=0
VITE_FLAG_AGE_GATE=true   # 18+ до покупки: npm run launch:check считает выключенный гейт ошибкой на денежном запуске
VITE_FLAG_LIMITED_PACK=0
VITE_FLAG_DEBUG_PANEL=0
VITE_ONRAMP_URL=
VITE_DAPP_STORE_URL=

# --- image refs (empty = build locally and use `guttercaps/<name>:local`) ---
# CI publishes the three images and writes the pinned refs (with digests) into ops/deploy/images.env;
# `cat ops/deploy/images.env >> ops/deploy/.env` is then the whole deploy, and rolling back is reverting that
# one file. Setting one of these by hand is the host-builds-its-own path — that is what `TAG` used to be for
# (runbook §7), and a single tag for three images was only ever a rollback lever while all three moved together.
API_IMAGE=
CLIENT_IMAGE=
BACKUP_IMAGE=

# --- host plumbing ---
# Bind to 127.0.0.1 and let the TLS terminator front it; 0.0.0.0 only if this *is* the public edge.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Worker set for the api supervisor. Launch set for the full game incl. Floodgrid:
# crank,pyth,reward,gridcharge (reward = kind-4 claims/ladder, gridcharge = droplet staking sync).
WORKERS=crank,pyth
CRANK_KEYPAIR_PATH=./secrets/crank_keypair.json
# The initial backfill decides this one; 30 m is enough for a fresh mainnet indexer at 1 000/tx page.
BACKFILL_START_PERIOD=30m

# --- legal gating (paid randomised packs; see backend/src/geo.ts, docs/09 §5.2) ---
# off  — the gate is dark: /packs/quote sells everywhere, me().flags.geoRestricted is always false.
# shop — the block applies to the purchase only (market / staking / arena keep working).
# Turn this on only together with GEO_TRUST_HEADER=1 AND Cloudflare (or another edge that *assigns*
# cf-ipcountry) in front: nginx copies that header into X-Geo-Country, and a value the buyer can set is
# not a legal control, it is a suggestion.
GEO_GATE=off
GEO_TRUST_HEADER=0
GEO_RESTRICT_COUNTRIES=BE,NL
# allow — an unknown country may buy (a misconfigured edge degrades to "no gate", loud in the logs).
# block — an unknown country may not (the strict reading; a broken edge stops all sales instead of
# silently violating a jurisdiction). Choose deliberately, this is the one value with no safe default.
GEO_UNKNOWN=allow

# --- redis ---
REDIS_MAXMEMORY=128mb

# --- backups (see ops/backup/sqlite-backup.sh, runbook §4) ---
BACKUP_INTERVAL_S=3600
BACKUP_KEEP=72
# SEC-B48: corrupt snapshots are kept for forensics but are not covered by BACKUP_KEEP above; a disk that
# fills is the one failure a single-writer SQLite cannot absorb, so this list is bounded too.
BACKUP_KEEP_CORRUPT=3
BACKUP_S3_URI=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# --- monitoring (profile: monitoring) ---
PROM_BIND=127.0.0.1
PROM_RETENTION=30d
# Alertmanager UI (the notification log, the silences). Same default bind as Prometheus: the pipeline
# works without it, this is only where a human reads what was sent. Pages go to the `alert-webhook`
# compose service (ops/monitoring/alert-webhook.mjs), which logs them and optionally forwards.
ALERTMANAGER_BIND=127.0.0.1
# Optional: the alert-webhook sidecar (ops/monitoring/alert-webhook.mjs) logs every page even when
# these are empty. Set one or both to actually wake a human. Alertmanager itself does not expand
# env vars, which is why the receiver URL is the compose service name, not these values.
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=

# Age / country / feature gating. `1` is REQUIRED in production — the API refuses to start without
# it (assertProductionConfig, SEC-A7 2026-10-02). Authentication, admin access and privacy
# restrictions are enforced either way; this switch is what makes backend/access-policy.json real
# (packs denied in BE/NL, minimumAge 18).
# The geo half is fail-closed on its own: GEO_GATE=shop needs GEO_TRUST_HEADER=1 (a header only your
# edge sets — see nginx `set_real_ip_from` / your CDN) or every buyer reads as unknown and is
# blocked, and assertProductionConfig rejects a gate that is on but untrusted.
# Находка 10, решение владельца 2026-11-03: значение обязательно, допустимы 1 и 0.
# 1 = access-policy.json (18+, BE/NL) исполняется; 0 = гейты выключены для всех — режим разрешён,
# но каждый старт печатает [compliance] предупреждение, чтобы «политика отложена» было видно в логах.
# Пока нет доверенного источника страны (GEO_TRUST_HEADER=1 от края) гейт с 1 отвечает 403 country_unknown.
COMPLIANCE_ENFORCE=0
