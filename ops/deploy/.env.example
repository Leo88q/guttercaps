# GUTTERCAPS compose deploy — the variables `ops/deploy/docker-compose.yaml` interpolates.
#
# This is NOT the app's config: the app reads backend/.env (see that file's example for the full list
# of 95 vars). What is here is only what compose itself needs, and the reason it is small is
# deliberate — every value the app reads from a container env is one more thing to forget at 3 a.m.
#
# Copy to .env next to this file, then:  npm run ops:build && npm run ops:up
# Validation without Docker: `npm run env:check` (this file vs the compose file, both directions).
#
# ── required, no default ───────────────────────────────────────────────────────────────────────
#   VITE_SOLANA_RPC   a mainnet RPC the *browser* may use; keep the key rate-limited per origin.
#   PROGRAM_*         the four program ids from `npm run program-ids -- manifest`. They are passed to
#                     BOTH images on purpose: the client bundle and the API must not be able to disagree,
#                     and a mismatch is a game where every transaction fails with 0x177a.
#   CG_MINT, USDC_MINT, SKR_MINT   mints, resolved by address (never by symbol).
# ── secrets live in files, not here ────────────────────────────────────────────────────────────
#   CRANK_KEYPAIR_PATH  path to the crank hot keypair (default ./secrets/crank_keypair.json, which is
#                       git-ignored). Mounted via compose `secrets:` so it does not appear in
#                       `docker inspect` or in `compose ps` output.

# --- cluster / program identity (shared by both images) ---
PROGRAM_CHIP_CORE=
PROGRAM_MARKET=
PROGRAM_STAKING=
PROGRAM_ARENA=
CG_MINT=
USDC_MINT=
SKR_MINT=
LOOKUP_TABLE=
TURNSTILE_SITE_KEY=   # client build arg; the verifying half (TURNSTILE_SECRET + TURNSTILE_HOSTNAMES +
                      # TURNSTILE_ACTION) lives in backend/.env — see the runbook §1.2

# --- client build (baked into the bundle at build time; changing them needs `ops:build`, not a restart) ---
VITE_CLUSTER=mainnet-beta
VITE_SOLANA_RPC=
VITE_SENTRY_DSN=

# --- image refs (empty = build locally and use `guttercaps/<name>:local`) ---
# CI publishes the three images and writes the pinned refs (with digests) into ops/deploy/images.env;
# `cat ops/deploy/images.env >> ops/deploy/.env` is then the whole deploy, and rolling back is reverting that
# one file. Setting one of these by hand is the host-builds-its-own path — that is what `TAG` used to be for
# (runbook §7), and a single tag for three images was only ever a rollback lever while all three moved together.
API_IMAGE=
CLIENT_IMAGE=
BACKUP_IMAGE=

# --- host plumbing ---
# Bind to 127.0.0.1 and let the TLS terminator front it; 0.0.0.0 only if this *is* the public edge.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
WORKERS=crank,pyth
CRANK_KEYPAIR_PATH=./secrets/crank_keypair.json
# The initial backfill decides this one; 30 m is enough for a fresh mainnet indexer at 1 000/tx page.
BACKFILL_START_PERIOD=30m

# --- legal gating (paid randomised packs; see backend/src/geo.ts, docs/09 §5.2) ---
# off  — the gate is dark: /packs/quote sells everywhere, me().flags.geoRestricted is always false.
# shop — the block applies to the purchase only (market / staking / arena keep working).
# Turn this on only together with GEO_TRUST_HEADER=1 AND Cloudflare (or another edge that *assigns*
# cf-ipcountry) in front: nginx copies that header into X-Geo-Country, and a value the buyer can set is
# not a legal control, it is a suggestion.
GEO_GATE=off
GEO_TRUST_HEADER=0
GEO_RESTRICT_COUNTRIES=BE,NL
# allow — an unknown country may buy (a misconfigured edge degrades to "no gate", loud in the logs).
# block — an unknown country may not (the strict reading; a broken edge stops all sales instead of
# silently violating a jurisdiction). Choose deliberately, this is the one value with no safe default.
GEO_UNKNOWN=allow

# --- redis ---
REDIS_MAXMEMORY=128mb

# --- backups (see ops/backup/sqlite-backup.sh) ---
BACKUP_INTERVAL_S=3600
BACKUP_KEEP=72
BACKUP_S3_URI=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# --- monitoring (profile: monitoring) ---
PROM_BIND=127.0.0.1
PROM_RETENTION=30d
