# syntax=docker/dockerfile:1.7
# GUTTERCAPS client: a Vite build, served by nginx which also proxies /v1 and /ws (runbook.md §1.3).
#
# Read this before adding a variable: the bundle is baked at BUILD time, so these are build ARGs and
# the values must exist as ENV for Vite to see them (an ARG alone is invisible to the build process —
# "I set it in docker-compose and nothing changed" is that bug). `VITE_API_MOCK` and friends therefore
# cannot be flipped on a running production origin, which is the security property we want, and the
# assertion below fails the build if a required value was forgotten instead of shipping a bundle that
# quietly points at devnet placeholders.
ARG NODE_IMAGE=node:24.21.0-slim
ARG NGINX_IMAGE=nginx:1.27.4-alpine

FROM ${NODE_IMAGE} AS build
WORKDIR /app
ENV NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false

# Имена ниже — ровно те, что читает client/src/app/config.ts (находка 6). До этого образ объявлял
# VITE_SOLANA_RPC / VITE_SOLANA_WS, которых приложение не читает вовсе, а VITE_RPC_URL, VITE_RPC_WS_URL,
# VITE_DAS_RPC_URL, VITE_PROGRAM_SETTLE, VITE_LAUNCH_PHASE и все VITE_FLAG_* объявлены не были — то есть
# «build args ok» печаталось для набора, из которого половина ни на что не влияла, а нужное оставалось
# константой: браузер уходил на публичный clusterApiUrl(mainnet), а фазовый запуск работал как full.
ARG VITE_CLUSTER
ARG VITE_RPC_URL
ARG VITE_RPC_WS_URL
ARG VITE_DAS_RPC_URL
ARG VITE_API_BASE
ARG VITE_WS_BASE
ARG VITE_PROGRAM_CHIP_CORE
ARG VITE_PROGRAM_MARKET
ARG VITE_PROGRAM_STAKING
ARG VITE_PROGRAM_ARENA
ARG VITE_PROGRAM_SETTLE
ARG VITE_CG_MINT
ARG VITE_USDC_MINT
ARG VITE_SKR_MINT
ARG VITE_LOOKUP_TABLE
ARG VITE_LAUNCH_PHASE
ARG VITE_FLAG_GEO_GATE
ARG VITE_FLAG_AGE_GATE
ARG VITE_FLAG_LIMITED_PACK
ARG VITE_FLAG_DEBUG_PANEL
ARG VITE_ONRAMP_URL
ARG VITE_DAPP_STORE_URL
# SEC-B55: declared purely so it can be *refused* below. The in-browser mock answers /v1 and /ws with
# plausible data and "signs in" a wallet nobody owns; it must never be the backend of a deployed origin.
ARG VITE_API_MOCK
# ARG → ENV: this is the step people skip, and the only thing Vite reads is the environment.
ENV VITE_CLUSTER=$VITE_CLUSTER VITE_RPC_URL=$VITE_RPC_URL VITE_RPC_WS_URL=$VITE_RPC_WS_URL \
    VITE_DAS_RPC_URL=$VITE_DAS_RPC_URL VITE_API_BASE=$VITE_API_BASE VITE_WS_BASE=$VITE_WS_BASE \
    VITE_PROGRAM_CHIP_CORE=$VITE_PROGRAM_CHIP_CORE VITE_PROGRAM_MARKET=$VITE_PROGRAM_MARKET \
    VITE_PROGRAM_STAKING=$VITE_PROGRAM_STAKING VITE_PROGRAM_ARENA=$VITE_PROGRAM_ARENA \
    VITE_PROGRAM_SETTLE=$VITE_PROGRAM_SETTLE \
    VITE_CG_MINT=$VITE_CG_MINT VITE_USDC_MINT=$VITE_USDC_MINT VITE_SKR_MINT=$VITE_SKR_MINT \
    VITE_LOOKUP_TABLE=$VITE_LOOKUP_TABLE VITE_LAUNCH_PHASE=$VITE_LAUNCH_PHASE \
    VITE_FLAG_GEO_GATE=$VITE_FLAG_GEO_GATE VITE_FLAG_AGE_GATE=$VITE_FLAG_AGE_GATE \
    VITE_FLAG_LIMITED_PACK=$VITE_FLAG_LIMITED_PACK VITE_FLAG_DEBUG_PANEL=$VITE_FLAG_DEBUG_PANEL \
    VITE_ONRAMP_URL=$VITE_ONRAMP_URL VITE_DAPP_STORE_URL=$VITE_DAPP_STORE_URL VITE_API_MOCK=$VITE_API_MOCK

COPY package.json package-lock.json ./
COPY client/package.json client/
# Full install here: the client build needs devDependencies (vite, typescript, the plugins).
RUN npm ci --no-audit --no-fund
COPY client client/
COPY packages packages/

# The freeze-commit ids must be in the bundle. The list below is the CURRENT dev-derived id set from
# `Anchor.toml` (`[programs.devnet]`, five programs); a mainnet build that still carries any of them is
# refused, because players would then sign transactions for a program that holds nothing while the app
# looked healthy. Before, the list held `GCRhrg…`/`GCA2aU…`/`GCuGx7…`/`GCfERi…` — addresses that exist
# neither in `Anchor.toml` nor in any `declare_id!`, so the guard could never fire, and `settle`
# (the fifth program) was missing from it entirely (находка 51).
# Escape hatch: `npm run program-ids -- guard-mainnet` (the id ceremony rewrites Anchor.toml, and the
# short comment below points at it).
RUN node --input-type=module -e " \
const need = { VITE_CLUSTER: process.env.VITE_CLUSTER, VITE_RPC_URL: process.env.VITE_RPC_URL, VITE_API_BASE: process.env.VITE_API_BASE, VITE_PROGRAM_CHIP_CORE: process.env.VITE_PROGRAM_CHIP_CORE, VITE_PROGRAM_MARKET: process.env.VITE_PROGRAM_MARKET, VITE_PROGRAM_STAKING: process.env.VITE_PROGRAM_STAKING, VITE_PROGRAM_ARENA: process.env.VITE_PROGRAM_ARENA, VITE_PROGRAM_SETTLE: process.env.VITE_PROGRAM_SETTLE, VITE_CG_MINT: process.env.VITE_CG_MINT, VITE_SKR_MINT: process.env.VITE_SKR_MINT }; \
const missing = Object.entries(need).filter(([, v]) => !v).map(([k]) => k); \
if (missing.length) { console.error('missing build args: ' + missing.join(', ')); process.exit(1); } \
const PLACEHOLDERS = ['J68G8KrbLTSdi68LHr9Kkw1YbRRHv3uBPirWCd5Xt13V','5skEmmhgFYn5xjHEdrcsiQ68kUg5kvhXKhjWTWSppjfo','Ewkbp7WpqbiJAu3ofEcTPinqnr5oH3e94YJDZFg1eSJn','DUTokrhWBYL7nJ9VbMy7bFELQFf8TN1tmvVpKLsskqD6','B9ousNDpe29G45KFHyndvHXpLigBtxCh9xbboWuCeXyP']; \
if (need.VITE_CLUSTER === 'mainnet-beta') { \
  const stuck = Object.entries(need).filter(([, v]) => PLACEHOLDERS.includes(v)); \
  if (stuck.length) { console.error('mainnet build with dev placeholder program id(s): ' + stuck.map(([k]) => k).join(', ') + ' — the id ceremony has not run yet: npm run program-ids -- guard-mainnet'); process.exit(1); } \
} \
console.log('build args ok for cluster ' + need.VITE_CLUSTER); \
"

# SEC-B55: the build context may not contribute a build-time switch this Dockerfile does not declare.
# `vite build` loads `.env`, `.env.local`, `.env.production` and `.env.production.local` from the client root
# and lets them set any `VITE_*` name; the ENV line above wins for the names it declares, so an *undeclared*
# name in one of those files lands in the bundle silently — which is how `VITE_API_MOCK` (the in-browser
# mock backend: fake balances, fake sign-in) or `VITE_FLAG_DEBUG_PANEL` could reach production from a
# developer's `.env.local`, the file client/.env.example tells them to create. `.dockerignore` keeps those
# files out of the context; this is the half that holds if the ignore list ever drifts.
RUN node --input-type=module -e " \
import { existsSync, readFileSync } from 'node:fs'; \
const DECLARED = new Set(['VITE_CLUSTER','VITE_RPC_URL','VITE_RPC_WS_URL','VITE_DAS_RPC_URL','VITE_API_BASE','VITE_WS_BASE','VITE_PROGRAM_CHIP_CORE','VITE_PROGRAM_MARKET','VITE_PROGRAM_STAKING','VITE_PROGRAM_ARENA','VITE_PROGRAM_SETTLE','VITE_CG_MINT','VITE_USDC_MINT','VITE_SKR_MINT','VITE_LOOKUP_TABLE','VITE_LAUNCH_PHASE','VITE_FLAG_GEO_GATE','VITE_FLAG_AGE_GATE','VITE_FLAG_LIMITED_PACK','VITE_FLAG_DEBUG_PANEL','VITE_ONRAMP_URL','VITE_DAPP_STORE_URL','VITE_API_MOCK']); \
const files = ['client/.env','client/.env.local','client/.env.production','client/.env.production.local']; \
const strays = []; \
for (const f of files) { \
  if (!existsSync(f)) continue; \
  for (const line of readFileSync(f, 'utf8').split('\n')) { \
    if (/^\s*#/.test(line)) continue; \
    const m = /^\s*(?:export\s+)?([A-Z][A-Z0-9_]*)\s*=/.exec(line); \
    if (m && m[1].startsWith('VITE_') && !DECLARED.has(m[1])) strays.push(f + ': ' + m[1]); \
  } \
} \
const mock = (process.env.VITE_API_MOCK || '').trim(); \
if (mock && !/^(0|false)$/i.test(mock)) strays.push('VITE_API_MOCK=' + mock); \
if (strays.length) { \
  console.error('refusing to build — undeclared VITE_ switch visible at build time: ' + strays.join(', ') + '. The client bundle is baked here: remove the file, or declare the variable in this Dockerfile (and in compose) if it is meant to be deployable.'); \
  process.exit(1); \
} \
console.log('no undeclared VITE_ switch in the build context (' + files.length + ' file names checked)'); \
"

RUN npm --prefix client run build \
 && node -e " \
const fs = require('fs'), p = 'client/dist'; \
if (!fs.existsSync(p + '/index.html')) { console.error('no index.html'); process.exit(1); } \
const walk = (d) => fs.readdirSync(d, { withFileTypes: true }).flatMap((e) => e.isDirectory() ? walk(d + '/' + e.name) : [d + '/' + e.name]); \
const files = walk(p); \
const html = fs.readFileSync(p + '/index.html', 'utf8'); \
if (/undefined|\\[object Object\\]/.test(html)) { console.error('index.html contains undefined — a VITE_ arg did not reach the build'); process.exit(1); } \
const maps = files.filter((f) => f.endsWith('.js.map')); \
for (const m of maps) fs.rmSync(m); \
if (maps.length) console.log('stripped ' + maps.length + ' sourcemap(s) (upload them to Sentry BEFORE this stage if you need symbolicated stacks)'); \
const js = files.filter((f) => f.endsWith('.js')); \
const gz = files.filter((f) => /\.(js|css|html)$/.test(f)).length; \
console.log('client bundle ok: ' + js.length + ' chunks, ' + gz + ' gzip-precompressible files'); \
if (!js.length) process.exit(1); \
"

FROM ${NGINX_IMAGE} AS runtime
# Replace, don't append: the committed config carries the cache / CSP / websocket rules, and leaving
# the stock default.conf beside it invites "why is /assets not immutable" at 3 a.m.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY --from=build /app/client/dist /usr/share/nginx/html
COPY ops/deploy/nginx.conf /etc/nginx/conf.d/app.conf
EXPOSE 8080
# `wget` exists in nginx:alpine (busybox); this checks the SPA is served, not that the API is up —
# nginx answers /healthz locally for exactly that reason.
HEALTHCHECK --interval=20s --timeout=3s --retries=3 \
  CMD ["sh", "-c", "wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1"]
CMD ["nginx", "-g", "daemon off;"]
