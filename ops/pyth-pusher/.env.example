# Copy to .env — docker-compose.yaml reads it. Never commit .env or payer.json.

# Solana RPC the pusher submits through (a paid endpoint; public RPC rate-limits sendTransaction).
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE
# Optional second RPC for the `ha` profile (docker compose --profile ha up -d)
SOLANA_RPC_URL_B=

# Hermes (Pyth price service). Since the 2026-08-26 Pyth Core upgrade EVERY Hermes request
# needs a Pyth API key (free tier is enough for 2 feeds): https://pythdata.app/signup
HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=REPLACE

# Our push-oracle shard — 0xCA75 = 51829 (packages/economy/src/oracle.ts::PYTH_SHARD_ID).
# Derived accounts: SOL/USD ELp9x5sFxGJ7zTurykU2p6A9nKDx72b3xzPxfsB5S8GB · SKR/USD 9bCSdQVWckgKipe4G3G66aYU9yq2ZdDn8kRPZB9Nihbc
PYTH_SHARD_ID=51829
PYTH_PUSH_ORACLE=pythWSnswVUd12oZpeFP8e9CVaEqJg25g1Vtc2biRsT

# Pusher cadence (mirrors PYTH_PUSHER in oracle.ts; the per-feed triggers live in price-config.yaml)
PUSHING_FREQUENCY_S=10
POLLING_FREQUENCY_S=5
CU_PRICE_MICRO_LAMPORTS=200

# Pin the image version (no :latest tag exists): https://gallery.ecr.aws/pyth-network/xc-price-pusher
# Must be >= v10.5.0: `--hermes-access-token` (the Pyth API key every Hermes request needs since 2026-08-26) does
# not exist before it — v9.3.0 starts without a key and Hermes answers 401. v13.0.0 is the newest tag on the gallery.
PUSHER_VERSION=v13.0.0

# --- generated by `npm run env:example` — do not edit below this line ---
# Values are the code's own defaults: this file lists everything readable, not everything to
# change. Prose goes above the marker; the block below it is generated by `npm run env:example`.
# ---- ops/pyth-pusher/docker-compose.yaml ----
PUSHER_VERSION=    # no literal default in code
SOLANA_RPC_URL=    # no literal default in code
PYTH_SHARD_ID=    # no literal default in code
HERMES_URL=    # no literal default in code
PYTH_API_KEY=    # no literal default in code
PYTH_PUSH_ORACLE=    # no literal default in code
PUSHING_FREQUENCY_S=    # no literal default in code
POLLING_FREQUENCY_S=    # no literal default in code
CU_PRICE_MICRO_LAMPORTS=    # no literal default in code
SOLANA_RPC_URL_B=    # no literal default in code
HERMES_URL_B=    # no literal default in code
