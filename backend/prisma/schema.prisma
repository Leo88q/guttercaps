// GUTTERCAPS backend — PostgreSQL schema (Prisma 6)
// Source of truth for projections is `events_raw` (replayable). Everything
// else is a derived view maintained by the indexer. See docs/03-architecture.md §3.2.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Raw chain events — idempotent by (signature, ixIndex, eventIndex)
// ---------------------------------------------------------------------------
model EventRaw {
  /// Surrogate ordering key, not decoration: the replay walker is `ORDER BY slot ASC, id ASC`
  /// (backend/src/ingest.ts:81) and SQLite's rowid supplies it. Without a monotonic
  /// column the Postgres port cannot replay in insertion order for equal slots.
  id         BigInt @id @default(autoincrement())
  signature  String
  ixIndex    Int      @map("ix_index")
  eventIndex Int      @map("event_index")
  program    String   // chip_core | market | staking | arena
  name       String   // PackOpened, ChipSold, ...
  data       Json
  slot       BigInt
  blockTime  DateTime @map("block_time")
  processed  Boolean  @default(false)
  /// SEC-M5: set by the finality reconciler once the cluster reports the tx finalized; NULL = confirmed only.
  /// Value-bearing reads (paid services, quest roots, referrals) only trust rows with finalizedAt set.
  finalizedAt DateTime? @map("finalized_at")

  /// idempotency is the triple's job, not the primary key's: `INSERT OR IGNORE` on
  /// (signature, ix_index, event_index) is what makes a re-scanned slot harmless.
  @@unique([signature, ixIndex, eventIndex])
  @@index([program, name, slot])
  @@index([processed, slot])
  @@index([finalizedAt, slot])
  @@map("events_raw")
}

model IndexerCursor {
  program          String   @id
  /// Column names are the indexer's, not the documentation's: ingest.ts upserts
  /// (program, newest_signature, newest_slot, history_complete, updated_at) — see backend/src/ingest.ts:96-105.
  /// A target table with `last_slot`/`last_sig` would ship a Postgres rollout whose very first write fails.
  /// `history_complete` is the backfill flag (`npm run backend:backfill` sets it after a full walk); the
  /// readyz probe reads it, so it cannot be an optional extra either.
  newestSignature  String?  @map("newest_signature")
  newestSlot       BigInt?  @map("newest_slot")
  historyComplete  Boolean  @default(false) @map("history_complete")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("indexer_cursor")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------
model Wallet {
  address     String   @id
  firstSeen   DateTime @default(now()) @map("first_seen")
  lastSeen    DateTime @default(now()) @map("last_seen")
  referrer    String?
  handle      String?  @unique
  avatarAsset String?  @map("avatar_asset")
  flags       Json     @default("{}") // { shadowBanned, rewardsPaused, trusted, note }
  riskScore   Int      @default(0) @map("risk_score")
  country     String?  // from CF header at first SIWS, for geo rules (BE/NL loot-box law)
  fingerprint String?  // legacy single-device column — superseded by WalletDevice (many devices per wallet, T-B-49)
  handleSetAt DateTime? @map("handle_set_at") // 30-day change cooldown anchor

  chips        Chip[]
  servicePayments ServicePayment[]
  entitlements    Entitlement[]
  listings     Listing[]      @relation("seller")
  sessions     Session[]
  questCompletions QuestCompletion[]
  ratings      Rating[]
  fraudSignals FraudSignal[]
  referrals    Referral[]     @relation("referrer")
  referredBy   Referral?      @relation("referee")
  pity         Pity?

  @@index([riskScore])
  @@map("wallets")
}

model Session {
  id        String   @id @default(cuid())
  wallet    String
  /// double-submit token — every non-GET request must echo it in x-csrf-token (backend/src/server.ts).
  /// It has no column in the old draft of this model, which is how a Postgres rollout would silently lose
  /// CSRF protection: `Session.csrf` is what the running code writes.
  csrf      String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  // `ip` and `ua` are deliberately absent. The published privacy text promises that rate limiting keeps the
  // counter and not the address (client/src/shared/lib/legal.ts), so a session table full of IPs and
  // user-agents would contradict it. If a future feature needs either, it needs a new privacy line first.
  w         Wallet   @relation(fields: [wallet], references: [address])

  @@index([wallet])
  @@map("sessions")
}

/// One-shot SIWS challenges. Separate from `Session` on purpose: a nonce is consumed by the verify handler and
/// expires in minutes, a session lives for SESSION_TTL_S — the old draft kept the nonce on the session row,
/// which is why `Session.nonce` existed here and `siws_nonces` did not.
model SiwsNonce {
  nonce      String    @id
  wallet     String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")

  @@index([wallet])
  @@map("siws_nonces")
}

model Referral {
  referee     String   @id
  referrer    String
  createdAt   DateTime @default(now()) @map("created_at")
  paidCgMicro BigInt   @default(0) @map("paid_cg_micro") // cumulative 5 % payouts, cap 200 $CG
  refereeSpendCents Int @default(0) @map("referee_spend_cents")
  r           Wallet   @relation("referrer", fields: [referrer], references: [address])
  e           Wallet   @relation("referee", fields: [referee], references: [address])

  @@index([referrer])
  @@map("referrals")
}

// ---------------------------------------------------------------------------
// Chips (projection of ChipState + Core owner)
// ---------------------------------------------------------------------------
model Chip {
  asset         String   @id
  owner         String
  collectionIdx Int      @map("collection_idx")
  rarity        Int      // 0..8, ladder fixed
  level         Int      @default(1)
  indexNo       BigInt   @map("index_no") // the game mint number (`Name #N`) — the SQLite indexer keeps it in `chips.game_index`
  gameIndex     BigInt?  @map("game_index") // NULL = the number is not resolved on chain yet (the crank back-fills it from ChipState)
  flags         Int      @default(0) // bit0 staked, bit1 listed, bit2 fusing, bit3 soulbound
  lockUntil     DateTime? @map("lock_until")
  origin        String   @default("pack") // pack | fusion | reward
  skin          String?  // cosmetic skin id from economy SKINS, NULL = none
  mintedAt      DateTime @map("minted_at")
  burnedAt      DateTime? @map("burned_at")
  updatedSlot   BigInt   @map("updated_slot")
  indexAttempts Int      @default(0) @map("index_attempts") // SQLite-only bookkeeping for the back-fill queue (parked at CRANK_INDEX_ATTEMPTS)
  w             Wallet   @relation(fields: [owner], references: [address])
  listing       Listing?

  @@index([owner, burnedAt])
  @@index([collectionIdx, rarity, burnedAt])
  @@index([rarity, level])
  @@map("chips")
}

model Collection {
  idx        Int    @id
  symbol     String
  name       String
  element    Int    // 0 paint 1 steel 2 wheels 3 noise 4 shadow
  coreCollection String @map("core_collection")
  minted     BigInt @default(0)
  mintedByRarity Json @default("[0,0,0,0,0,0,0,0,0]") @map("minted_by_rarity")
  lore       Json   @default("{}")

  @@map("collections")
}

model Pity {
  wallet        String @id
  counters      Json   @default("[0,0,0,0]") // per SKU
  boughtToday   Json   @default("[0,0,0,0]") @map("bought_today")
  dayStart      DateTime? @map("day_start")
  starterClaimed Boolean @default(false) @map("starter_claimed")
  w             Wallet @relation(fields: [wallet], references: [address])

  @@map("pity")
}

// ---------------------------------------------------------------------------
// Packs & fusion (audit trail of every VRF outcome)
// ---------------------------------------------------------------------------
model PackPurchase {
  nonce        BigInt
  buyer        String
  sku          Int
  qty          Int
  currency     Int      // 0 SOL 1 USDC 2 CG
  amount       BigInt
  randomness   String
  commitSlot   BigInt   @map("commit_slot")
  signature    String   @unique
  status       String   @default("pending") // pending | opened | cancelled | stale
  createdAt    DateTime @map("created_at")
  opens        PackOpen[]

  @@id([buyer, nonce])
  @@index([status, commitSlot])
  @@map("pack_purchases")
}

/// Quest chip vouchers (backlog #28): free 1-chip PendingPacks issued by chip_core `open_voucher` (CPI from staking
/// `claim_chip_root`). Kept apart from PackPurchase so payer / Starter stats stay clean; the crank and /me/pending union it.
model Voucher {
  wallet     String
  nonce      BigInt
  template   Int      // index into QUEST_CHIP_TEMPLATES (odds + soulbound days)
  randomness String
  signature  String
  slot       BigInt
  blockTime  DateTime? @map("block_time")
  status     String   @default("pending") // pending | opened | cancelled

  @@id([wallet, nonce])
  @@index([status])
  @@map("vouchers")
}

model PackOpen {
  signature   String   @id
  buyer       String
  nonce       BigInt
  packNo      Int      @map("pack_no")
  sku         Int
  assets      String[]
  rarities    Int[]
  collections Int[]
  rollBytes   Bytes    @map("roll_bytes")
  pityBefore  Int      @map("pity_before")
  pityAfter   Int      @map("pity_after")
  slot        BigInt
  blockTime   DateTime @map("block_time")
  purchase    PackPurchase @relation(fields: [buyer, nonce], references: [buyer, nonce])

  @@index([buyer, blockTime])
  @@index([sku, blockTime])
  @@map("pack_opens")
}

model CompressedSettlement {
  buyer            String
  nonce            BigInt
  totalClaims      Int      @default(0) @map("total_claims")
  registeredClaims Int      @default(0) @map("registered_claims")
  cancelledClaims  Int      @default(0) @map("cancelled_claims")
  status           String   @default("pending")
  lastSignature    String   @map("last_signature")
  lastSlot         BigInt   @map("last_slot")
  blockTime        DateTime? @map("block_time")
  claims           CompressedClaim[]

  @@id([buyer, nonce])
  @@index([status, lastSlot])
  @@map("compressed_settlements")
}

model CompressedClaim {
  buyer             String
  nonce             BigInt
  claimNonce        BigInt  @map("claim_nonce")
  packNo            Int     @map("pack_no")
  status            String  @default("pending")
  asset             String?
  collectionIdx     Int?    @map("collection_idx")
  rarity            Int?
  level             Int?
  gameIndex         BigInt? @map("game_index")
  mintSignature     String? @map("mint_signature")
  registerSignature String? @map("register_signature")
  slot              BigInt
  blockTime         DateTime? @map("block_time")
  settlement        CompressedSettlement @relation(fields: [buyer, nonce], references: [buyer, nonce], onDelete: Cascade)

  @@id([buyer, nonce, claimNonce])
  @@index([status, slot])
  @@index([asset])
  @@map("compressed_claims")
}

model Fusion {
  signature   String   @id
  owner       String
  recipe      Int
  materials   String[]
  result      String?
  success     Boolean
  rollBps     Int      @map("roll_bps")
  thresholdBps Int     @map("threshold_bps")
  feeBurned   BigInt   @map("fee_burned")
  boosted     Boolean  @default(false)
  blockTime   DateTime @map("block_time")

  @@index([owner, blockTime])
  @@index([recipe, success])
  @@map("fusions")
}

// ---------------------------------------------------------------------------
// Marketplace
// ---------------------------------------------------------------------------
model Listing {
  asset       String   @id
  seller      String
  price       BigInt
  currency    Int      // 0 SOL 1 USDC
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  cancelledAt DateTime? @map("cancelled_at")
  soldAt      DateTime? @map("sold_at")
  chip        Chip     @relation(fields: [asset], references: [asset])
  s           Wallet   @relation("seller", fields: [seller], references: [address])

  @@index([cancelledAt, soldAt, currency, price])
  @@map("listings")
}

model Sale {
  id        String   @id @default(cuid())
  asset     String
  seller    String
  buyer     String
  price     BigInt
  currency  Int
  fee       BigInt
  royalty   BigInt
  viaOffer  Boolean  @default(false) @map("via_offer")
  signature String   @unique
  slot      BigInt
  blockTime DateTime @map("block_time")
  // denormalized for floor/volume queries
  collectionIdx Int  @map("collection_idx")
  rarity    Int

  @@index([collectionIdx, rarity, blockTime])
  @@index([buyer])
  @@index([seller])
  @@map("sales")
}

model Offer {
  asset     String
  bidder    String
  amount    BigInt
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @map("created_at")
  closedAt  DateTime? @map("closed_at")
  outcome   String?  // accepted | cancelled | expired

  @@id([asset, bidder])
  @@index([asset, expiresAt])
  @@map("offers")
}

model FloorSnapshot {
  collectionIdx Int      @map("collection_idx")
  rarity        Int
  ts            DateTime
  floorLamports BigInt?  @map("floor_lamports")
  floorUsdc     BigInt?  @map("floor_usdc")
  listedCount   Int      @map("listed_count")
  volume24hUsd  Decimal  @default(0) @map("volume_24h_usd") @db.Decimal(18, 2)

  @@id([collectionIdx, rarity, ts])
  @@index([ts])
  @@map("floor_snapshots")
}

// ---------------------------------------------------------------------------
// Staking & emission
// ---------------------------------------------------------------------------
model StakeCg {
  wallet   String
  tier     Int
  amount   BigInt
  weight   Decimal  @db.Decimal(40, 0)
  since    DateTime
  unlockAt DateTime @map("unlock_at")
  claimedTotal BigInt @default(0) @map("claimed_total")

  @@id([wallet, tier])
  @@map("stakes_cg")
}

model StakeChip {
  asset   String   @id
  wallet  String
  weight  Decimal  @db.Decimal(40, 0)
  since   DateTime
  claimedTotal BigInt @default(0) @map("claimed_total")

  @@index([wallet])
  @@map("stakes_chip")
}

model SetBonus {
  wallet        String   @id
  completedSets Int      @map("completed_sets")
  syncedAt      DateTime? @map("synced_at")
  pendingSets   Int?     @map("pending_sets") // computed by set-oracle, awaiting on-chain sync

  @@map("set_bonus")
}

model EmissionDay {
  dayIndex    Int      @id @map("day_index")
  year        Int
  scheduleCap BigInt   @map("schedule_cap")
  guarded     BigInt
  burn7dAvg   BigInt   @map("burn_7d_avg")
  sliceBudget Json     @map("slice_budget")
  burnedToday BigInt   @default(0) @map("burned_today")
  mintedToday BigInt   @default(0) @map("minted_today")
  closedAt    DateTime @map("closed_at")

  @@map("emission_days")
}

/// $CG burned outside the staking program (chip_core BurnReported, market listing fee, arena rake burn) —
/// the source for the SEC-M1 burn oracle; staking's own early-exit rows are stored with program = 'staking'
/// for /stats but are never reported (already counted on-chain by record_internal_burn).
model Burn {
  signature  String
  eventIndex Int       @map("event_index")
  program    String    // chip_core | market | arena | staking
  source     String    // chip_core: 0 pack / 1 fusion / 3 service; market: listing_fee; arena: rake_burn; staking: early_exit
  amount     BigInt
  slot       BigInt
  blockTime  DateTime? @map("block_time")

  @@id([signature, eventIndex])
  @@index([program, slot])
  @@map("burns")
}

/// SEC-M1 burn-oracle cursor (single row): everything at/below `lastRowid` (events_raw id) was reported.
model BurnOracleCursor {
  id            Int      @id @default(1)
  lastRowid     BigInt   @map("last_rowid")
  reportedTotal BigInt   @default(0) @map("reported_total")
  lastSignature String?  @map("last_signature")
  lastAmount    BigInt?  @map("last_amount")
  updatedAt     DateTime? @map("updated_at")

  @@map("burn_oracle_cursor")
}

/// Reward currency of a Merkle root: $CG roots (kinds 2–4) are minted by `["emission"]`,
/// SKR roots (kinds 5–7) are paid from the treasury-funded `["skr_pool"]` — never minted.
enum RewardCurrency {
  CG
  SKR
  ITEM // kind 8: fusion boosters — amount is a unit count (backlog #27)
}

model RewardRoot {
  id         String   @id @default(cuid())
  kind       Int      // $CG: 2 quests 3 pvp 4 events · SKR: 5 quests 6 season 7 events · ITEM: 8 boosters
  epoch      Int
  currency   RewardCurrency @default(CG)
  root       Bytes
  budget     BigInt   // micro-units of `currency` (both tokens have 6 decimals)
  claimed    BigInt   @default(0)
  leaves     Json     // [{wallet, amount, currency, proof[]}] served to clients
  publishedSig String? @map("published_sig")
  publishedAt DateTime? @map("published_at")
  revokedAt  DateTime? @map("revoked_at")
  claims     RewardClaim[]

  @@unique([kind, epoch])
  @@index([currency, epoch])
  @@map("reward_roots")
}

model RewardClaim {
  rootId    String
  wallet    String
  currency  RewardCurrency @default(CG)
  amount    BigInt
  signature String   @unique
  claimedAt DateTime @map("claimed_at")
  root      RewardRoot @relation(fields: [rootId], references: [id])

  @@id([rootId, wallet])
  @@index([wallet, currency])
  @@map("reward_claims")
}

/// SKR prize-pool ledger (`SkrFunded` / `SkrWithdrawn` / `SkrPoolChanged`): a treasury
/// liability, not token supply. `GET /v1/rewards/skr-pool` is a fold over this table plus
/// SKR roots/claims (`vault ≥ budget + reserved` is enforced on-chain).
/// SKR prize-pool distribution periods (reward-oracle.ts, kinds 5 Seeker week / 6 season): one row per finished week / settled season so a period is never paid twice.
model SkrAllotment {
  kind      Int
  periodKey String   @map("period_key")   // w<weekIndex> | s<seasonId>
  wallets   Int
  budget    BigInt                        // micro-SKR ('0' = nothing to pay for this period)
  epoch     Int?                          // reward_batches epoch (null when nothing was built)
  createdAt DateTime @map("created_at")

  @@id([kind, periodKey])
  @@map("skr_allotments")
}

/// SEC-L5: staking::SliceFunded — season pool (arena 20 % rake) burned into a slice; re-minted at claim outside the schedule.
model SliceFunding {
  signature     String
  eventIndex    Int      @map("event_index")
  byWallet      String   @map("by_wallet")
  kind          Int
  amount        BigInt
  sliceBudget   Json     @map("slice_budget")   // string[5] after the funding
  recycledTotal BigInt   @map("recycled_total")
  slot          BigInt
  blockTime     DateTime? @map("block_time")

  @@id([signature, eventIndex])
  @@index([kind, slot])
  @@map("slice_fundings")
}

model SkrPoolEvent {
  signature     String
  eventIndex    Int      @map("event_index")
  kind          SkrPoolEventKind
  counterparty  String?  // funder or withdrawal destination
  amount        BigInt   @default(0)
  budget        BigInt?
  reserved      BigInt?
  maxRootBudget BigInt?  @map("max_root_budget")
  paused        Boolean?
  slot          BigInt
  blockTime     DateTime? @map("block_time")

  @@id([signature, eventIndex])
  @@index([kind, slot])
  @@map("skr_pool_events")
}

enum SkrPoolEventKind {
  funded
  withdrawn
  changed
}

// ---------------------------------------------------------------------------
// Arena (PvP)
// ---------------------------------------------------------------------------
model Season {
  id        Int      @id
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  serverSecretHash String @map("server_secret_hash") // sha256(secret) published at start
  serverSecret     String  @map("server_secret")     // hex; never returned before ends_at → every match auditable afterwards
  revealedAt DateTime? @map("revealed_at")
  settledAt  DateTime? @map("settled_at")            // ladder payout computed into season_payouts (reward-oracle)
  poolMicro  BigInt?   @map("pool_micro")            // pool frozen at settlement = emission share + rake share
  rakeMicro     BigInt?   @map("rake_micro")         // SEC-L5: 20 % wager rake of the season (finalized battles), recycled by staking::fund_slice
  rakeFundedAt  DateTime? @map("rake_funded_at")     // reward oracle saw EmissionState.recycled_total cover this season
  rakeFundedSig String?   @map("rake_funded_sig")    // fund_slice signature ('covered' when nothing had to be sent)
  payouts    SeasonPayout[]

  @@map("seasons")
}

// Season ladder payouts (docs/02 §4.5 brackets) — paid through kind-3 roots like match rewards.
model SeasonPayout {
  season    Int
  wallet    String
  rank      Int
  games     Int
  rating    Float
  amount    BigInt
  rootKind  Int?     @map("root_kind")
  rootEpoch Int?     @map("root_epoch")
  s         Season   @relation(fields: [season], references: [id])

  @@id([season, wallet])
  @@index([rootKind, wallet])
  @@map("season_payouts")
}

// Server-authoritative matchmaking queue (one ticket per wallet); Redis-backed at scale, table in v1.
model ArenaQueue {
  ticket    String   @id
  wallet    String   @unique
  season    Int
  squad     Json     // FighterChip[3]
  power     Int
  league    Int
  rating    Float
  commitHex String   @map("commit_hex") // sha256(nonce) the player committed to
  joinedAt  DateTime @map("joined_at")

  @@index([season, league, joinedAt])
  @@map("arena_queue")
}

model Match {
  id          String   @id
  season      Int
  a           String
  b           String   // 'bot:<league>' for bot fills
  squadA      Json     @map("squad_a")
  squadB      Json     @map("squad_b")
  powerA      Int      @map("power_a")
  powerB      Int      @map("power_b")
  league      Int
  commitA     String   @map("commit_a")
  commitB     String   @map("commit_b")
  nonceA      String?  @map("nonce_a")
  nonceB      String?  @map("nonce_b")
  seed        String?  // hex sha256(matchId ‖ nonceA ‖ nonceB ‖ serverSecret)
  rounds      Json?    // FightRound[]
  winner      String?
  forfeit     Boolean  @default(false)
  rewarded    Boolean  @default(false)
  rewardA     BigInt   @default(0) @map("reward_a")
  rewardB     BigInt   @default(0) @map("reward_b")
  wager       BigInt   @default(0)
  battlePda   String?  @map("battle_pda")   // on-chain WagerBattle for wagered matches (battle-resolver)
  resolveSig  String?  @map("resolve_sig")
  status      String   @default("revealing") // revealing | resolved | cancelled
  startedAt   DateTime @map("started_at")
  endedAt     DateTime? @map("ended_at")

  @@index([a, startedAt])
  @@index([b, startedAt])
  @@index([status, startedAt])
  @@index([season, status])
  @@map("matches")
}

model Rating {
  wallet String
  season Int
  rating Float    @default(1000)
  games  Int      @default(0)
  wins   Int      @default(0)
  streak Int      @default(0)
  league Int      @default(0)
  updatedAt DateTime? @map("updated_at")
  w      Wallet   @relation(fields: [wallet], references: [address])

  @@id([wallet, season])
  @@index([season, rating(sort: Desc)])
  @@map("ratings")
}

// Per-match $CG rewards (2 / 0.5 $CG, 8 rewarded matches per day) — paid through kind-3 Merkle roots by the reward oracle.
model PvpReward {
  matchId   String  @map("match_id")
  wallet    String
  amount    BigInt
  day       Int     // unix day of the match
  rootKind  Int?    @map("root_kind")
  rootEpoch Int?    @map("root_epoch")

  @@id([matchId, wallet])
  @@index([wallet, day])
  @@index([rootKind, wallet])
  @@map("pvp_rewards")
}

// ---------------------------------------------------------------------------
// Quests (backend/src/quests.ts) + reward oracle (backend/src/reward-oracle.ts)
// ---------------------------------------------------------------------------
// The only client-driven quest metric: one row per (wallet, day) behind the eligibility gate.
model QuestLogin {
  wallet      String
  day         Int
  minuteOfDay Int?   @map("minute_of_day") // first login of the day (UTC minute) — quest-bot detector input

  @@id([wallet, day])
  @@map("quest_logins")
}

// "All four $CG dailies done that day" — streak input, maintained from FINALIZED events only.
model QuestDay {
  wallet      String
  day         Int
  dailiesDone Boolean @default(false) @map("dailies_done")

  @@id([wallet, day])
  @@map("quest_days")
}

// A completion becomes a row once the reward oracle has verified it against FINALIZED events
// (SEC-M5, finality.ts finalizedHorizon); root_* set when it joined a kind-2 Merkle root.
model QuestCompletion {
  wallet        String
  questId       String  @map("quest_id")
  periodKey     String  @map("period_key")   // d<unixDay> | w<weekIndex> | all
  amount        BigInt                       // micro $CG actually credited (after daily/weekly caps)
  rewardChip    Json?   @map("reward_chip")  // { template, odds, soulboundDays } → kind-9 chip voucher root (chipRoot*), delivered by claim_chip_root (#28)
  rewardBooster Int     @default(0) @map("reward_booster") // boosters owed → kind-8 item root (itemRoot*), delivered by claim_item_root
  completedAt   DateTime @map("completed_at") // settlement time
  day           Int     @default(0)           // unix day the daily / weekly cap is attributed to
  rootKind      Int?    @map("root_kind")     // $CG leaf (kind 2)
  rootEpoch     Int?    @map("root_epoch")
  itemRootKind  Int?    @map("item_root_kind") // booster leaf (kind 8)
  itemRootEpoch Int?    @map("item_root_epoch")
  chipRootKind  Int?    @map("chip_root_kind") // chip voucher leaf (kind 9) — one voucher per wallet per epoch
  chipRootEpoch Int?    @map("chip_root_epoch")
  w             Wallet  @relation(fields: [wallet], references: [address])

  @@id([wallet, questId, periodKey])
  @@index([rootKind, wallet])
  @@index([itemRootKind, wallet])
  @@index([chipRootKind, wallet])
  @@index([wallet, day])
  @@map("quest_completions")
}

// One Merkle root per (kind, epoch) built by the reward oracle; `publish_root` tx recorded once confirmed.
model RewardBatch {
  kind        Int
  epoch       Int
  root        String
  budget      BigInt
  leaves      Int
  signature   String?
  publishedAt DateTime? @map("published_at")
  status      String    @default("pending")  // pending | published | failed
  lastError   String?   @map("last_error")
  createdAt   DateTime  @map("created_at")
  leafRows    RewardLeaf[]

  @@id([kind, epoch])
  @@index([status, createdAt])
  @@map("reward_batches")
}

model RewardLeaf {
  kind   Int
  epoch  Int
  wallet String
  amount BigInt
  proof  Json     // hex[]
  memo   Json?    // which quests / matches / season ranks this leaf pays
  batch  RewardBatch @relation(fields: [kind, epoch], references: [kind, epoch])

  @@id([kind, epoch, wallet])
  @@index([wallet])
  @@map("reward_leaves")
}

// ---------------------------------------------------------------------------
// Live-ops & anti-fraud
// ---------------------------------------------------------------------------
model EconomyParam {
  key       String
  version   Int
  value     Json
  changedBy String   @map("changed_by")
  changedAt DateTime @default(now()) @map("changed_at")
  onChainSig String? @map("on_chain_sig") // set_params signature, when applicable
  note      String?

  @@id([key, version])
  @@map("economy_params")
}

/// SEC-H2 on-chain pause audit trail (`PauseChanged{by, paused}` from chip_core / staking / arena).
model PauseChange {
  signature  String
  eventIndex Int       @map("event_index")
  program    String    // chip_core | staking | arena
  byWallet   String    @map("by_wallet")
  paused     Boolean
  slot       BigInt
  blockTime  DateTime? @map("block_time")

  @@id([signature, eventIndex])
  @@index([program, slot])
  @@map("pause_changes")
}

/// SEC-G05 governance-key audit trail: one row per rotated role (`PauserChanged`, `AdminProposed`,
/// `AdminAccepted`, `CollectionCreated`, `ArenaConfigChanged` → battle_oracle + treasury_cg,
/// `OraclesChanged` → quest/season/set/burn_oracle). `detail` keeps the whole event payload.
model AuthorityChange {
  signature  String
  eventIndex Int       @map("event_index")
  program    String    // chip_core | staking | arena
  kind       String    // pauser | admin_proposed | admin | collection | battle_oracle | treasury_cg | quest_oracle | season_oracle | set_oracle | burn_oracle
  byWallet   String    @map("by_wallet")
  key        String    // the new key (base58; default pubkey = cleared)
  detail     Json
  slot       BigInt
  blockTime  DateTime? @map("block_time")

  @@id([signature, eventIndex, kind])
  @@index([slot])
  @@map("authority_changes")
}

model FeatureFlag {
  key       String  @id
  enabled   Boolean @default(false)
  rollout   Int     @default(100) // percentage
  payload   Json    @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

// Admin audit log (backend/src/admin.ts): every /admin/* call — allowed or denied — with body / result summary.
model AdminAudit {
  id      Int      @id @default(autoincrement())
  wallet  String
  action  String   // params.get | params.propose | kill_switch | simulate | fraud.queue | fraud.resolve | kpi | audit.read | denied:<METHOD> <path>
  target  String?
  payload Json?
  ip      String?
  ok      Boolean  @default(true)
  ts      DateTime @default(now())

  @@index([wallet, id])
  @@map("admin_audit")
}

// Proof of human + device dedupe (backend/src/human.ts, T-B-49). Not projections — kept on rebuild.
model HumanCheck {
  wallet     String   @id
  verifiedAt DateTime @map("verified_at")
  expiresAt  DateTime @map("expires_at")   // verified_at + HUMAN_CHECK_TTL_S (7 d)
  ipNet      String?  @map("ip_net")       // /24 (v4) or /48 (v6) the pass came from
  hostname   String?                       // Turnstile-reported hostname
  action     String?

  @@index([expiresAt])
  @@map("human_checks")
}

model WalletDevice {
  deviceHash String   @map("device_hash")  // sha256(DEVICE_SALT || client fingerprint) — the raw fingerprint is never stored
  wallet     String
  firstSeen  DateTime @map("first_seen")   // rank on a device: the first DEVICE_MAX_WALLETS (3) keep earning
  lastSeen   DateTime @map("last_seen")
  seen       Int      @default(1)

  @@id([deviceHash, wallet])
  @@index([wallet, lastSeen])
  @@map("wallet_devices")
}

// Detector output (backend/src/antifraud.ts): one OPEN row per (wallet, kind, fingerprint); ops resolves
// through the admin service → wallets.flags { rewardsPaused, shadowBanned, note }. Nothing is banned automatically.
model FraudSignal {
  id          Int      @id @default(autoincrement())
  wallet      String
  kind        String   // win_trading | wash_trade | quest_bot | multi_account | device_ring
  score       Int      // 0..100 heuristic
  evidence    Json
  fingerprint String   // kind + subject (pair / asset / referrer) — dedupes re-runs
  ts          DateTime @default(now())
  resolution  String?  // ignore | shadow_ban | rewards_pause | ban | unflag | trust
  resolvedBy  String?  @map("resolved_by")
  resolvedAt  DateTime? @map("resolved_at")
  w           Wallet   @relation(fields: [wallet], references: [address])

  @@index([wallet, ts])
  @@index([kind, score])
  @@index([wallet, kind, fingerprint, resolution]) // Postgres: add a partial unique index WHERE resolution IS NULL in the migration
  @@map("fraud_signals")
}

model AdminUser {
  id     String @id @default(cuid())
  email  String @unique
  role   String // viewer | liveops | economy | admin
  totpSecret String? @map("totp_secret")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model AuditLog {
  id      String   @id @default(cuid())
  actor   String
  action  String
  target  String?
  before  Json?
  after   Json?
  ts      DateTime @default(now())

  @@index([actor, ts])
  @@index([action, ts])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Analytics events (client + server) — partitioned by month in migration SQL
// ---------------------------------------------------------------------------
model AnalyticsEvent {
  id        BigInt   @id @default(autoincrement())
  wallet    String?
  anonId    String?  @map("anon_id")
  name      String   // screen_view, pack_reveal_started, ...
  props     Json     @default("{}")
  ts        DateTime @default(now())
  sessionId String?  @map("session_id")

  @@index([name, ts])
  @@index([wallet, ts])
  @@map("analytics_events")
}

// ------------------------------------------------------------------ paid services (backend/src/services.ts)

/// One row per on-chain `ServicePaid` event. `consumedBy` makes every receipt single-use.
model ServicePayment {
  signature  String
  eventIndex Int      @map("event_index")
  buyer      String
  kind       Int      // economy ServiceKind (0 handle … 9 district banner)
  currency   Int      // 0 SOL, 1 USDC, 2 CG, 3 SKR
  amount     Decimal  @db.Decimal(30, 0)
  burned     Decimal  @db.Decimal(30, 0)
  refHash    Bytes    @map("ref_hash") // keccak256(0x00 ‖ kind ‖ wallet ‖ payload)
  slot       BigInt
  blockTime  DateTime? @map("block_time")
  consumedBy String?  @map("consumed_by") // 'handle:<name>' | 'entitlement:<id>'
  consumedAt DateTime? @map("consumed_at")

  wallet Wallet @relation(fields: [buyer], references: [address])

  @@id([signature, eventIndex])
  @@index([buyer, kind, slot])
  @@map("service_payments")
}

/// What a payment bought (handle, skin on a cap, theme, emote pack, season pass …).
model Entitlement {
  id        BigInt   @id @default(autoincrement())
  wallet    String
  kind      Int
  payload   Json     // canonical JSON that hashed into ref_hash
  signature String
  currency  Int
  amount    Decimal  @db.Decimal(30, 0)
  grantedAt DateTime @default(now()) @map("granted_at")
  expiresAt DateTime? @map("expires_at") // season pass: +42 days

  owner Wallet @relation(fields: [wallet], references: [address])

  @@index([wallet])
  @@index([signature])
  @@map("entitlements")
}

/// Released handles stay unavailable to other wallets for 90 days.
model HandleHistory {
  id         BigInt   @id @default(autoincrement())
  handle     String
  wallet     String
  releasedAt DateTime @default(now()) @map("released_at")

  @@index([handle, releasedAt])
  @@map("handle_history")
}

/// 120-second soft reservation created by GET /me/handle/check.
model HandleReservation {
  handle    String   @id
  wallet    String
  expiresAt DateTime @map("expires_at")

  @@map("handle_reservations")
}

/// Crank worker state (backend/src/crank.ts, docs/06 §4.3): one row per program-owned
/// Switchboard randomness account we shepherd. key = kind:owner:nonce.
/// phase: pending → settled (pinned account gone) → closed (rent reclaimed); stale = refund
/// window open with a silent oracle; abandoned = CRANK_MAX_ATTEMPTS exhausted (alert, hourly retry).
/// `lut_slot` / `lut_closed_at` (SEC-M8, backlog #23): the request's Switchboard address lookup table,
/// and when its rent was reclaimed — recorded while the randomness account still exists, because that
/// account is the only place the slot is written.
model CrankJob {
  key        String   @id
  kind       Int      // 0 pack | 1 fusion | 2 battle
  owner      String
  nonce      Decimal  @db.Decimal(20, 0)
  randomness String
  pinned     String   // PendingPack / PendingFusion / WagerBattle PDA
  phase      String   @default("pending")
  commitSlot BigInt?  @map("commit_slot")
  attempts   Int      @default(0)
  nextAt     DateTime @default(now()) @map("next_at")
  lastError  String?  @map("last_error")
  revealSig  String?  @map("reveal_sig")
  settleSigs Json     @default("[]") @map("settle_sigs")
  closeSig   String?  @map("close_sig")
  lutSlot    BigInt?  @map("lut_slot")      // Switchboard lookup-table slot of this request (NULL = not recorded)
  lutClosedAt DateTime? @map("lut_closed_at") // when close_randomness_lut landed (second half of the rent)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([phase, nextAt])
  @@index([owner])
  @@map("crank_jobs")
}

/// Arena spray-tags (service kind 4): cosmetic shouts on a match, no gameplay effect.
model MatchEmote {
  id        BigInt   @id @default(autoincrement())
  matchId   String   @map("match_id")
  wallet    String
  side      String   // a | b
  emote     String   // emote id from economy EMOTE_PACKS
  createdAt DateTime @map("created_at")

  @@index([matchId])
  @@map("match_emotes")
}

/// Season-pass XP ledger: one row per wallet per season (ranked play only).
model PassXp {
  wallet String
  season Int
  xp     Int    @default(0)

  @@id([wallet, season])
  @@map("pass_xp")
}

/// Claimed pass tiers (one row per wallet/season/tier; the reward itself is an Entitlement).
model PassClaim {
  wallet    String
  season    Int
  tier      Int
  claimedAt DateTime @map("claimed_at")

  @@id([wallet, season, tier])
  @@map("pass_claims")
}
