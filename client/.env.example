# GUTTERCAPS client — build-time config (`import.meta.env.VITE_*`).
#
# The rule that matters: anything that must differ between devnet and mainnet is *inlined at build
# time*, so the deployed bundle is not reconfigurable at runtime and `VITE_API_MOCK` cannot be flipped
# on a production origin by accident (it is honoured only on localhost — see src/app/config.ts).
#
# ── required for a real deploy ───────────────────────────────────────────────────────────────
#   VITE_PROGRAM_*        the four program ids (must equal the backend's; `economy:check` pins that).
#   VITE_SOLANA_RPC       a rate-limited proxy URL. The public devnet endpoint is a dev convenience only.
#   VITE_API_BASE / VITE_WS_BASE   relative by default: same-origin behind nginx (docs/09 §4.1).
#   VITE_TURNSTILE_SITE_KEY        human check on claim paths; empty = the flow stays usable, not human.
# Copy to .env.local and adjust. Vite only exposes vars prefixed VITE_.

# Solana cluster: devnet | mainnet-beta | localnet
VITE_CLUSTER=devnet
# RPC endpoint the *browser* uses (Helius/Triton/QuickNode key is fine — it's rate-limited per origin).
VITE_RPC_URL=https://api.devnet.solana.com
# Optional websocket endpoint (defaults to the RPC url with wss://).
VITE_RPC_WS_URL=
# DAS endpoint for the mint → register step (getAsset/getAssetProof). Empty = reuse VITE_RPC_URL,
# which works only when the provider exposes DAS methods (Helius/Triton do; public endpoints do not).
VITE_DAS_RPC_URL=

# Backend REST base (relative in prod/dev — Vite proxies /v1 to VITE_DEV_API_TARGET).
VITE_API_BASE=/v1
VITE_WS_BASE=/ws
# Dev-only: where the Vite proxy forwards /v1 and /ws.
VITE_DEV_API_TARGET=http://127.0.0.1:8787

# Feature flags (all default off/false)
VITE_FLAG_GEO_GATE=false          # BE/NL lootbox gate (docs/00-prd.md §9) — off by default per Phase 4 decision
VITE_FLAG_LIMITED_PACK=false      # show Limited Event SKU in the shop even when GameConfig.enabled=false (preview mode)
VITE_FLAG_DEBUG_PANEL=false       # tx inspector + fake-open reveal buttons
# Proof of human (T-B-49): no client config needed — the Turnstile site key comes from the API (`/me.human.siteKey`,
# backend TURNSTILE_SITE_KEY); the widget script is loaded on demand from challenges.cloudflare.com only when a pass is required.

# Fiat on-ramp deep link (crypto-only v1; we just link out — no custodial flow)
VITE_ONRAMP_URL=https://buy.moonpay.com/?defaultCurrencyCode=sol

# Program ids — must match Anchor.toml / declare_id! after `anchor keys sync`.
VITE_PROGRAM_CHIP_CORE=J68G8KrbLTSdi68LHr9Kkw1YbRRHv3uBPirWCd5Xt13V
VITE_PROGRAM_MARKET=5skEmmhgFYn5xjHEdrcsiQ68kUg5kvhXKhjWTWSppjfo
VITE_PROGRAM_STAKING=Ewkbp7WpqbiJAu3ofEcTPinqnr5oH3e94YJDZFg1eSJn
VITE_PROGRAM_ARENA=DUTokrhWBYL7nJ9VbMy7bFELQFf8TN1tmvVpKLsskqD6

# Static Address Lookup Table from `npm run create-lut` (per cluster). Lets reveal + open_pack share one
# transaction; empty → they are sent one after another (5-chip $CG bundles then need the table).
VITE_LOOKUP_TABLE=

# Mints (devnet placeholders — filled by scripts/setup.ts output)
VITE_CG_MINT=
VITE_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

