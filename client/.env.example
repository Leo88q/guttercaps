VITE_API_MOCK=    # no literal default in code
VITE_CLUSTER=    # no literal default in code
VITE_RPC_URL=    # no literal default in code
VITE_RPC_WS_URL=    # no literal default in code
VITE_WS_BASE=    # no literal default in code
VITE_FLAG_GEO_GATE=    # no literal default in code
VITE_FLAG_AGE_GATE=    # no literal default in code
VITE_FLAG_LIMITED_PACK=    # no literal default in code
VITE_FLAG_DEBUG_PANEL=    # no literal default in code
VITE_ONRAMP_URL=    # no literal default in code
VITE_PROGRAM_CHIP_CORE=    # no literal default in code
VITE_PROGRAM_MARKET=    # no literal default in code
VITE_PROGRAM_STAKING=    # no literal default in code
VITE_PROGRAM_ARENA=    # no literal default in code
VITE_CG_MINT=    # no literal default in code
VITE_USDC_MINT=    # no literal default in code
VITE_SKR_MINT=    # no literal default in code
VITE_LOOKUP_TABLE=    # no literal default in code

